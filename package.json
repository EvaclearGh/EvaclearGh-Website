{
  "name": "evaclear-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Evaclear Trading Enterprise \u2014 online store (React + Tailwind)",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-server && node scripts/prerender.mjs",
    "build:spa": "node scripts/build-content.mjs && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
